# .env.example Sprint0 V1.2
# ⚠️ 重要：复制本文件为 .env 使用，严禁将 .env 文件提交到代码仓库
# ============================================================================
# 🔒 生产环境强制安全约束（生产部署必须全部修改）
# ============================================================================
# 1. POSTGRES_PASSWORD：生产使用至少16位强密码，禁止使用示例默认密码
# 2. LLM_API_KEY：生产环境通过密钥管理系统注入，禁止明文写入 .env
# 3. APP_ENV：生产必须修改为 production，禁止使用 dev
# 4. DATABASE_URL：自动由 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 组装；
#    如手动覆盖，禁止使用 localhost，容器内数据库服务名固定为 postgres
# 5. SECRET_KEY：生成参考命令 openssl rand -hex 32
# ============================================================================

# --- 数据库配置 ---
POSTGRES_USER=postgres

# 开发默认密码已加强，生产必须修改
POSTGRES_PASSWORD=dev_secure_pwd_CHANGE_ME
POSTGRES_DB=schematic_review

# 容器内部通信 URL
DATABASE_URL=postgresql+psycopg://postgres:dev_secure_pwd_CHANGE_ME@postgres:5432/schematic_review

# --- AI 服务 ---
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
DATA_DIR=/app/data

# --- 应用配置 ---
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=please_replace_this_secret_key_xxxx

# --- 端口映射（仅开发环境生效，可按需取消注释修改） ---
#BACKEND_PORT=8000
#FRONTEND_PORT=3000
#POSTGRES_PORT=5432
#PGADMIN_PORT=5050

# --- dev‑tools pgadmin工具配置 ---
#PGADMIN_EMAIL=dev@example.com
#PGADMIN_PASSWORD=devpwd

# --- 多实例隔离（可选） ---
# 方式1 Compose原生：设置环境变量 COMPOSE_PROJECT_NAME=dev01
# 方式2 卷/网络隔离：配合 VOLUME_SUFFIX / NETWORK_SUFFIX
#VOLUME_SUFFIX=dev01
#NETWORK_SUFFIX=dev01

# --- 镜像版本标签 ---
#TAG=sprint0
