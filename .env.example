# --- 数据库配置 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=schematic_review
# 容器内部通信 URL
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/schematic_review

# --- AI 服务 ---
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
DATA_DIR=/app/data

# --- 应用配置 ---
APP_ENV=dev
