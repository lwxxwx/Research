# ============================================================================
# .env.example Sprint0 V1.2
# 复制本文件为 .env 使用，严禁提交 .env 到代码仓库
# 完全对齐整套 docker‑compose 基座 + overlay + tools 配置
# ============================================================================
# 🔒 生产环境强制安全约束（生产部署必须全部修改）
# ============================================================================
# 1. POSTGRES_PASSWORD：生产使用至少16位强密码，禁止使用示例默认密码
# 2. LLM_API_KEY：生产环境优先密钥管理系统注入，禁止明文写入 .env
# 3. APP_ENV：生产必须修改为 production，禁止使用 dev
# 4. DATABASE_URL：如手动覆盖，容器内数据库host固定为 postgres，禁止 localhost
# 5. SECRET_KEY：生成参考命令 openssl rand -hex 32
# ============================================================================

# ===================== PostgreSQL 数据库配置 =====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_secure_pwd_CHANGE_ME
POSTGRES_DB=schematic_review

# Postgres 性能参数（基座docker-compose.yml读取）
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MAX_CONNECTIONS=20

# 数据库连接串
# 优先级：.env中DATABASE_URL > compose内部自动拼接默认值
# 容器内访问数据库必须使用服务名 postgres:5432
DATABASE_URL=postgresql+psycopg://postgres:dev_secure_pwd_CHANGE_ME@postgres:5432/schematic_review

# ===================== Backend FastAPI 应用配置 =====================
APP_ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=please_replace_this_secret_key_xxxx
PYTHONPATH=/app

# AI LLM 服务配置
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here

# 业务数据目录（容器内路径）
DATA_DIR=/app/data

# ===================== 开发环境端口映射（仅docker‑compose.dev.yml生效） =====================
# 取消注释可自定义宿主机端口，生产环境这些端口不会生效
#BACKEND_PORT=8000
#FRONTEND_PORT=3000
#POSTGRES_PORT=5432

# ===================== dev‑tools pgadmin 工具配置（docker‑compose.tools.yml --profile dev-tools） =====================
#PGADMIN_EMAIL=dev@example.com
#PGADMIN_PASSWORD=devpwd
#PGADMIN_PORT=5050

# ===================== 多实例并行开发隔离配置 =====================
# 两种多实例隔离方式：
# 方式1 Compose原生：环境变量 COMPOSE_PROJECT_NAME=dev01
# 方式2 卷&网络隔离：VOLUME_SUFFIX / NETWORK_SUFFIX，用于命名volume、network后缀
#VOLUME_SUFFIX=base
#NETWORK_SUFFIX=base

# ===================== 镜像构建TAG标签 =====================
# 构建backend镜像标签，docker‑compose.yml image字段读取 ${TAG:-latest}
#TAG=latest
